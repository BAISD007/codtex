{
  "name": "codtex",
  "version": "1.0.0",
  "description": "公式识别工具 - GLM OCR",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "node-llama-cpp": "^3.10.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.codmore.codtex",
    "productName": "codtex",
    "win": {
      "target": "nsis"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "models/**/*"
    ],
    "extraResources": [
      {
        "from": "models/",
        "to": "models/"
      }
    ]
  }
}
